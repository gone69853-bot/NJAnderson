    <script>
  if (navigator.userAgent.includes('Chrome')) {
    const hash = window.INITIAL_DATA.hashes.confWebAgg;

    const tsAlias =
      'true' === 'true'
        ? (new URLSearchParams(location.search).get('ts-alias') ?? undefined)
        : undefined;

    // Кука `ts-alias` (редизайн, см. src/utils/redesign.ts): в запрос конфига её
    // проставляет config/store.ts — здесь то же, иначе preload-URL не совпадёт с ним.
    const cookieAlias = (() => {
      if ('production' === 'production') return undefined;
      return document.cookie.match(/(?:^|; )ts-alias=([^;]*)/)?.[1] || undefined;
    })();

    const templateServiceAlias = tsAlias ?? cookieAlias;

    const templateServiceConfigParams = [
      ...(templateServiceAlias
        ? []
        : [
            window.INITIAL_DATA?.sduiConfig?.hash
              ? `h=${window.INITIAL_DATA?.sduiConfig?.hash}`
              : `id=${window.INITIAL_DATA?.traceId}`,
          ]),
      `country=${window.INITIAL_DATA.country}`,
      ...(window.INITIAL_DATA.subdivision ? [`subdivision=${window.INITIAL_DATA.subdivision}`] : []),
      ...(templateServiceAlias ? [`alias=${templateServiceAlias}`] : []),
      ...(window.INITIAL_DATA.ab?.encoded ? [`ab=${window.INITIAL_DATA.ab.encoded}`] : []),
    ].join('&');

    const apiPaths = [
      '/api/web/v1/user',
      `/api/web/v1/sdui/templates/by-types?${templateServiceConfigParams}`,
      '/api/USER-SERVICE-API/api-v3-oauth-config',
    ];

    try {
      for (const apiPath of apiPaths) {
        const link = document.createElement('link');
        link.rel = 'preload';
        link.href = apiPath;
        link.as = 'fetch';
        link.crossOrigin = '';
        document.head.append(link);
      }
    } catch (err) {
      console.warn('Preload script error', err);
    }
  }
</script>

